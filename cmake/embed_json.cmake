# Keep individual literals below MSVC's limit; the frozen rules remain portable C++.
function(minecraft_embed_json INPUT SYMBOL OUTPUT)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${INPUT}")
    file(READ "${INPUT}" WITCH_HUT_JSON)
    string(FIND "${WITCH_HUT_JSON}" ")SM_JSON\"" WITCH_HUT_DELIMITER)
    if(NOT WITCH_HUT_DELIMITER EQUAL -1)
        message(FATAL_ERROR "Embedded JSON contains its C++ delimiter: ${INPUT}")
    endif()
    string(LENGTH "${WITCH_HUT_JSON}" WITCH_HUT_JSON_LENGTH)
    set(WITCH_HUT_HEADER "#pragma once\n#include <array>\n#include <string_view>\nnamespace minecraft::version {\ninline constexpr std::array ${SYMBOL}{\n")
    set(WITCH_HUT_OFFSET 0)
    while(WITCH_HUT_OFFSET LESS WITCH_HUT_JSON_LENGTH)
        math(EXPR WITCH_HUT_REMAINING "${WITCH_HUT_JSON_LENGTH} - ${WITCH_HUT_OFFSET}")
        if(WITCH_HUT_REMAINING GREATER 16000)
            set(WITCH_HUT_REMAINING 16000)
        endif()
        string(SUBSTRING "${WITCH_HUT_JSON}" ${WITCH_HUT_OFFSET} ${WITCH_HUT_REMAINING} WITCH_HUT_PART)
        string(APPEND WITCH_HUT_HEADER "std::string_view{R\"SM_JSON(${WITCH_HUT_PART})SM_JSON\"},\n")
        math(EXPR WITCH_HUT_OFFSET "${WITCH_HUT_OFFSET} + ${WITCH_HUT_REMAINING}")
    endwhile()
    string(APPEND WITCH_HUT_HEADER "};\n}\n")
    file(WRITE "${OUTPUT}" "${WITCH_HUT_HEADER}")
endfunction()
